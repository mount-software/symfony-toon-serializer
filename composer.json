{
    "name": "mountsoftware/symfony-toon-serializer",
    "description": "Symfony Serializer integration for TOON (Token-Oriented Object Notation) on top of helgesverre/toon",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mount Software",
            "email": "info@mountsoftware.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "symfony/serializer": "^6.4 || ^7.0",
        "helgesverre/toon": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0",
        "symfony/property-access": "^6.4 || ^7.0",
        "symfony/var-dumper": "^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "MountSoftware\\SymfonyToonSerializer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MountSoftware\\SymfonyToonSerializer\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "scripts": {
        "test": "phpunit"
    }
}
